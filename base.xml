<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Common remotes -->
  <remote name="github" fetch="https://github.com/" />
  <remote name="yocto" fetch="https://git.yoctoproject.org/" />

  <!-- Keep the Yocto release aligned across all common layers -->
  <default remote="github" revision="scarthgap" sync-j="8" />

  <!-- Core Yocto -->
  <project
    name="yoctoproject/poky.git"
    path="poky"
    remote="github"
    revision="scarthgap" />

  <!-- OpenEmbedded layers -->
  <project
    name="openembedded/meta-openembedded.git"
    path="meta-openembedded"
    remote="github"
    revision="scarthgap" />
</manifest>
